@model ContatoModel
@{
    ViewData["Title"] = "Confirmação para Excluir contato";
}

<div class="text-center d-grid gap-2 mt-3">

    <h3>
        Você realmente deseja excluir o contato (@Model.Nome)?
    </h3>

    <a class="btn btn-primary" role="button" asp-controller="Contato" asp-action="Index">Cancelar exclusão</a>
    <a class="btn btn-primary btn-danger" role="button" asp-controller="Contato" asp-action="Apagar" asp-route-id="@Model.Id">Confirmar exclusão</a>
</div>